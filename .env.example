# Base URL of the ZDC backend API
# Local:  http://localhost:8080
# Render: https://zdc-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- Google Maps (optional) ----
# Enables address autocomplete + auto lat/long on B2B register/settings.
# Create a key in Google Cloud Console with the "Maps JavaScript API" and
# "Places API" enabled, then paste it here. Without it, the address field
# still works as a plain manual-entry input.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Social links (landing footer) ----
# NEXT_PUBLIC_SOCIAL_WHATSAPP=https://wa.me/2547XXXXXXXX
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/yourhandle
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/yourpage

# ---- Sentry (optional; error + performance monitoring) ----
# Public DSN from your Sentry project (Settings > Client Keys).
# NEXT_PUBLIC_SENTRY_DSN=https://cdf1f6a14edd2a95d85444c513b190ed@o4511886604894208.ingest.us.sentry.io/4511886732165120
# For source-map upload at build time (set in CI/Vercel, not required locally):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ---- PostHog (optional; product analytics) ----
# Project API key + host. Without these, analytics is fully disabled.
# NEXT_PUBLIC_POSTHOG_KEY=phc_s2Kb9T8FmoPHHoQuv5P5czjtiZgLiPJd4sz6YvcmW9xr
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
